<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      AUCUNE permission Internet ni réseau n'est demandée ici, et c'est
      volontaire (voir README-APK.md, section "Dépendances Internet
      désactivées") : sans android.permission.INTERNET, le système
      Android empêche physiquement l'application d'ouvrir une connexion
      réseau, quel que soit le code JavaScript ou natif exécuté. C'est la
      garantie la plus forte possible que le jeu reste hors ligne.
    -->

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/LaunchTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <!--
          allowBackup="false" : aucune sauvegarde automatique vers un
          compte Google/le cloud. Choix volontaire pour rester strictement
          local (voir README-APK.md) — à activer plus tard si vous
          souhaitez que les parties survivent à un changement de
          téléphone, ce qui sortirait alors du cadre "hors ligne".
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">
            <!--
              configChanges déclarés ci-dessus = l'Activity n'est PAS
              recréée à la rotation de l'écran : la WebView (donc la
              partie en cours) n'est jamais rechargée, seule la mise en
              page CSS s'adapte (déjà géré par css/menu.css et
              css/mobile.css depuis les vagues 13 et précédentes).
              Aucun android:screenOrientation fixé : le jeu doit rester
              jouable en portrait ET en paysage (cf. cahier des charges).
            -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
